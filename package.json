{
  "name": "osdlc-markdown",
  "private": true,
  "type": "module",
  "description": "Workspace root for the libraries published to npm from this repository's packages/ts/ directory.",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "test": "pnpm -r --if-present run test",
    "typecheck": "pnpm -r --if-present run typecheck",
    "smoke": "pnpm -r --if-present run smoke",
    "lint": "pnpm -r --if-present run lint",
    "format:check": "pnpm -r --if-present run format:check",
    "version-packages": "changeset version && conformance-suites write --reference ts"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@osdlc/conformance-suites": "^0.1.0",
    "@osdlc/package-checks": "^0.1.0"
  }
}
