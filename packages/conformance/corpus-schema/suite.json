{
  "family": "corpus-schema",
  "reference": "ts",
  "referenceVersion": "0.2.0",
  "sections": {
    "validate": {
      "description": "Validate one corpus, without --fix. `input.corpus` is a corpus folder relative to this file's folder. `expect` holds the `<file>: <field>` prefix of each error and of each warning, with the file relative to the corpus root: the text of a problem line up to its second `: `. Each list is sorted by UTF-16 code unit and holds each prefix once. An implementation passes a case when its two sets of prefixes match these. Message text and order are not compared.",
      "cases": [
        {
          "name": "the spec's example passes",
          "input": {
            "corpus": "corpora/standard-example"
          },
          "expect": {
            "errors": [],
            "warnings": []
          }
        },
        {
          "name": "a broken corpus reports each problem",
          "input": {
            "corpus": "corpora/broken"
          },
          "expect": {
            "errors": [
              "harnesses/Antigravity.md: body",
              "harnesses/Antigravity.md: status",
              "harnesses/Gemini CLI.md: successor",
              "harnesses/Kiro.md: (data)",
              "vendors/Acme.json: format"
            ],
            "warnings": [
              "harnesses/Gemini CLI.md: body"
            ]
          }
        },
        {
          "name": "level 1 allows an untyped type",
          "input": {
            "corpus": "corpora/level-1"
          },
          "expect": {
            "errors": [],
            "warnings": []
          }
        },
        {
          "name": "level 2 with a schema for every type passes",
          "input": {
            "corpus": "corpora/level-2"
          },
          "expect": {
            "errors": [],
            "warnings": []
          }
        },
        {
          "name": "level 2 makes an untyped type an error",
          "input": {
            "corpus": "corpora/level-2-untyped"
          },
          "expect": {
            "errors": [
              "notes/notes.schema.md: (schema)"
            ],
            "warnings": []
          }
        },
        {
          "name": "a level other than 1 or 2 is an error",
          "input": {
            "corpus": "corpora/level-bad"
          },
          "expect": {
            "errors": [
              "corpus-schema.yaml: level"
            ],
            "warnings": []
          }
        },
        {
          "name": "dialect and profiles are reserved, and other root keys warn",
          "input": {
            "corpus": "corpora/reserved-keys"
          },
          "expect": {
            "errors": [],
            "warnings": [
              "corpus-schema.yaml: dialect",
              "corpus-schema.yaml: flavour",
              "corpus-schema.yaml: profiles"
            ]
          }
        },
        {
          "name": "two types may share a schema's $id",
          "input": {
            "corpus": "corpora/shared-id"
          },
          "expect": {
            "errors": [],
            "warnings": []
          }
        },
        {
          "name": "a record folder owns its script, query and CSV, and links into another record's folder resolve",
          "input": {
            "corpus": "corpora/folder-record"
          },
          "expect": {
            "errors": [],
            "warnings": []
          }
        },
        {
          "name": "a folder with no record file named after it is a plain folder, as before",
          "input": {
            "corpus": "corpora/folder-record-missing"
          },
          "expect": {
            "errors": [
              "methods/Survey/notes.md: author",
              "methods/Survey/notes.md: question"
            ],
            "warnings": []
          }
        },
        {
          "name": "a record folder inside a record folder is an error",
          "input": {
            "corpus": "corpora/folder-record-nested"
          },
          "expect": {
            "errors": [
              "methods/Survey/Pilot: (folder)"
            ],
            "warnings": []
          }
        },
        {
          "name": "a record file in a format the corpus does not allow still makes a record folder",
          "input": {
            "corpus": "corpora/folder-record-format"
          },
          "expect": {
            "errors": [
              "methods/Survey/Survey.json: format"
            ],
            "warnings": []
          }
        },
        {
          "name": "extends resolves a parent by a relative path, and an x-ref links into its synced copy",
          "input": {
            "corpus": "corpora/extends-path"
          },
          "expect": {
            "errors": [],
            "warnings": []
          }
        },
        {
          "name": "extends resolves parents by package name, with and without a corpus field",
          "input": {
            "corpus": "corpora/extends-package"
          },
          "expect": {
            "errors": [],
            "warnings": []
          }
        },
        {
          "name": "a three-level chain: a record passes every schema up its x-extends chain",
          "input": {
            "corpus": "corpora/extends-chain"
          },
          "expect": {
            "errors": [],
            "warnings": []
          }
        },
        {
          "name": "an unknown prefix in x-extends or x-ref is an error",
          "input": {
            "corpus": "corpora/extends-unknown-prefix"
          },
          "expect": {
            "errors": [
              "rules/rules.schema.yaml: follows",
              "rules/rules.schema.yaml: x-extends"
            ],
            "warnings": []
          }
        },
        {
          "name": "a cycle of extends is an error",
          "input": {
            "corpus": "corpora/extends-cycle"
          },
          "expect": {
            "errors": [
              "corpus-schema.md: extends.p"
            ],
            "warnings": []
          }
        },
        {
          "name": "a package that is not installed is an error",
          "input": {
            "corpus": "corpora/extends-missing-package"
          },
          "expect": {
            "errors": [
              "corpus-schema.md: extends.claims"
            ],
            "warnings": []
          }
        },
        {
          "name": "a parent folder or package with no root file is an error",
          "input": {
            "corpus": "corpora/extends-not-a-corpus"
          },
          "expect": {
            "errors": [
              "corpus-schema.md: extends.pkg",
              "corpus-schema.md: extends.plain"
            ],
            "warnings": []
          }
        },
        {
          "name": "extends needs level 2",
          "input": {
            "corpus": "corpora/extends-level-1"
          },
          "expect": {
            "errors": [
              "corpus-schema.md: extends"
            ],
            "warnings": []
          }
        },
        {
          "name": "a record must pass its parent type's schema",
          "input": {
            "corpus": "corpora/extends-parent-schema"
          },
          "expect": {
            "errors": [
              "rules/No Statement.md: statement"
            ],
            "warnings": []
          }
        },
        {
          "name": "x-ref to an inherited type accepts its records and local records whose type extends it",
          "input": {
            "corpus": "corpora/extends-xref"
          },
          "expect": {
            "errors": [
              "guides/Wrong Type.md: follows"
            ],
            "warnings": []
          }
        },
        {
          "name": "a local record must not take an inherited record's id",
          "input": {
            "corpus": "corpora/extends-id-collision"
          },
          "expect": {
            "errors": [
              "rules/be kind.md: id"
            ],
            "warnings": []
          }
        },
        {
          "name": "a link into _inherited/ with no copy asks for sync",
          "input": {
            "corpus": "corpora/extends-copy-missing"
          },
          "expect": {
            "errors": [
              "_inherited/org: (copy)"
            ],
            "warnings": []
          }
        },
        {
          "name": "a stale _inherited/ copy reports each differing file",
          "input": {
            "corpus": "corpora/extends-copy-stale"
          },
          "expect": {
            "errors": [
              "_inherited/old: (copy)",
              "_inherited/org/principles/Extra.md: (copy)",
              "_inherited/org/principles/Ship Small.md: (copy)"
            ],
            "warnings": []
          }
        },
        {
          "name": "a closed child type admits the fields of every type it extends",
          "input": {
            "corpus": "corpora/extends-flatten"
          },
          "expect": {
            "errors": [],
            "warnings": []
          }
        },
        {
          "name": "a child type cannot loosen its parent, and a closed parent admits no new field",
          "input": {
            "corpus": "corpora/extends-flatten-loosen"
          },
          "expect": {
            "errors": [
              "howtos/Extra.md: extra",
              "howtos/Gone.md: status",
              "rules/Team Rule.md: team",
              "rules/rules.schema.yaml: properties.team"
            ],
            "warnings": []
          }
        },
        {
          "name": "a corpus that uses a parent's types and links to none of its files needs no copy",
          "input": {
            "corpus": "corpora/extends-copy-unneeded"
          },
          "expect": {
            "errors": [],
            "warnings": []
          }
        },
        {
          "name": "x-ref-form id and wikilink resolve a reference by id, here and in a parent",
          "input": {
            "corpus": "corpora/xref-id"
          },
          "expect": {
            "errors": [],
            "warnings": []
          }
        },
        {
          "name": "a reference by id must name one record of the type, in the form the field declares",
          "input": {
            "corpus": "corpora/xref-id-broken"
          },
          "expect": {
            "errors": [
              "_inherited/org: (copy)",
              "tasks/Ambiguous.md: depends_on",
              "tasks/Not A String.md: depends_on",
              "tasks/Path.md: about",
              "tasks/Unknown.md: depends_on",
              "tasks/tasks.schema.yaml: properties.note",
              "tasks/tasks.schema.yaml: see"
            ],
            "warnings": []
          }
        },
        {
          "name": "an x-ref list accepts a record of any listed type, or of a type that extends one",
          "input": {
            "corpus": "corpora/xref-types"
          },
          "expect": {
            "errors": [],
            "warnings": []
          }
        },
        {
          "name": "an x-ref list must name one or more types, and a record of another type fails",
          "input": {
            "corpus": "corpora/xref-types-broken"
          },
          "expect": {
            "errors": [
              "tasks/Build.md: after",
              "tasks/tasks.schema.yaml: empty",
              "tasks/tasks.schema.yaml: mixed"
            ],
            "warnings": []
          }
        }
      ]
    },
    "strict": {
      "description": "Validate one corpus with --strict. `input.corpus` and the prefixes in `expect` are as in the validate section. `expect.passes` is whether `validate --strict` passes the corpus: it does when the corpus has no errors and no warnings.",
      "cases": [
        {
          "name": "a corpus with no warnings passes",
          "input": {
            "corpus": "corpora/strict-clean"
          },
          "expect": {
            "errors": [],
            "warnings": [],
            "passes": true
          }
        },
        {
          "name": "a corpus whose only problem is a warning fails",
          "input": {
            "corpus": "corpora/strict-warning"
          },
          "expect": {
            "errors": [],
            "warnings": [
              "notes/A.md: body"
            ],
            "passes": false
          }
        }
      ]
    }
  }
}
